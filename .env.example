# Required for the Responses-compatible model endpoint.
SIGNALFEED_LLM_API_KEY=replace-with-model-api-key

# Required only for --send. Use credentials from a published custom app.
FEISHU_APP_ID=cli_replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_RECEIVE_ID=oc_replace-with-chat-id

# Recommended: use a dedicated database for Chinese digests.
SIGNALFEED_DB_PATH=data/signalfeed-zh.sqlite3
